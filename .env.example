CATALYST_AI_ENVIRONMENT=development
# The backend's Ed25519 public key(s), kid:base64url; two during a rotation. Public, not a secret;
# the development pair is the tooling's fixed seed (tools/origin.py), never a production key.
CATALYST_AI_AUTH_PUBLIC_KEYS=test-1:A6EHv_POEL4dcN0Y50vAmWfk1jCbpQ1fHdyGZBJVMbg
CATALYST_AI_DATABASE_URL=postgresql://catalyst_ai:catalyst_ai@localhost:5433/catalyst_ai
CATALYST_AI_HTTP_ADDR=:8090
CATALYST_AI_OPS_ADDR=:9091
CATALYST_AI_LOG_LEVEL=INFO
# Which model text work runs on here, as an alias the register resolves (`text-default`,
# `text-fast`, `text-long`) — never a model id: the register owns those, and a typo here must
# fail at boot rather than at the first call. `text-fast` is the cheapest row; the eval floors
# and the recorded fixtures were measured on `text-default`, so a set re-run under `text-fast`
# is a new measurement, not the same one. One capability may be lifted above this default with
# CATALYST_AI_CAPABILITY_<NAME>_MODEL_ALIAS.
CATALYST_AI_MODEL_TEXT_ALIAS=text-fast
# The provider key (RESTRICTED). Read only by the Gemini adapter; absent, every provider call is
# ai.provider.unavailable and the suite never needs it (fixtures replay).
CATALYST_AI_PROVIDER_GEMINI_API_KEY=
# The key `make record LIVE=1 CAP=<name>` reads to re-record a set's fixtures live (the same key).
CATALYST_AI_RECORD_PROVIDER_KEY=
# Optional: a PostgreSQL with pgvector for the storage tests and the retrieval eval; absent, a
# throwaway container is started.
CATALYST_AI_EVAL_DATABASE_URL=
