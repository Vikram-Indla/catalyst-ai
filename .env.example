CATALYST_AI_ENVIRONMENT=development
# The backend's Ed25519 public key(s), kid:base64url; two during a rotation. Public, not a secret;
# the development pair is the tooling's fixed seed (tools/origin.py), never a production key.
CATALYST_AI_AUTH_PUBLIC_KEYS=test-1:A6EHv_POEL4dcN0Y50vAmWfk1jCbpQ1fHdyGZBJVMbg
# A process run on the host (not in compose) reaches compose's database on loopback, and listens
# on loopback only; compose sets its own in-container addresses and database URLs.
CATALYST_AI_DATABASE_URL=postgresql://catalyst_ai:catalyst_ai@127.0.0.1:5434/catalyst_ai
CATALYST_AI_HTTP_ADDR=127.0.0.1:8090
CATALYST_AI_OPS_ADDR=127.0.0.1:9091
CATALYST_AI_LOG_LEVEL=INFO
# Which model text work runs on here, as an alias the register resolves (`text-default` or
# `text-fast`) — never a model id: the register owns those, and a typo here must fail at boot
# rather than at the first call. Today both resolve to the same row, the one stable model this
# key reaches; `text-long` is unavailable and refused at boot. `text-fast` is kept so an
# environment moves to a cheaper row the day one exists, with no configuration change. One capability may be lifted above this default with
# CATALYST_AI_CAPABILITY_<NAME>__MODEL_ALIAS.
CATALYST_AI_MODEL_TEXT_ALIAS=text-fast
# Each alias may be pinned to one of the register's priced ids; unset keeps the register's row.
# Any other id (a preview, a `-latest`, another provider's) refuses the start with the setting's
# name. A new model takes a register row first, with its published price and an eval run.
# Changing the embedding model means re-embedding the index (`catalyst-ai reembed`).
# CATALYST_AI_MODEL_TEXT_DEFAULT=gemini-3.6-flash
# CATALYST_AI_MODEL_TEXT_FAST=gemini-3.6-flash
# CATALYST_AI_MODEL_GRADER_DEFAULT=gemini-3.6-flash
# CATALYST_AI_MODEL_EMBED_DEFAULT=gemini-embedding-001
# The provider is Vertex AI's regional endpoint for the configured in-Kingdom location; tenant
# text is processed nowhere else, and a location outside the allowlist is refused everywhere.
# Required in staging and production; development falls back to the first allowed location.
CATALYST_AI_PROVIDER_VERTEX_LOCATION=me-central2
# The project it bills and runs in; a deployed process authenticates as its own workload identity,
# so no key or token is configured there. The suite never needs either (fixtures replay).
CATALYST_AI_PROVIDER_VERTEX_PROJECT=
# Development only (RESTRICTED): a developer's own short-lived token, from their own login, for a
# local run against the provider; refused outside development. Never a long-lived key.
# CATALYST_AI_PROVIDER_ACCESS_TOKEN=
# The token `make record LIVE=1 CAP=<name>` reads to re-record a set live (a developer's own,
# short-lived); authored inputs only. It expires within the hour, so a long recording can fail
# part-way with the provider's rejection: that is the token, not the provider; take a fresh one.
CATALYST_AI_RECORD_PROVIDER_TOKEN=
# Optional: a PostgreSQL with pgvector for the storage tests and the retrieval eval; absent, a
# throwaway container is started.
CATALYST_AI_EVAL_DATABASE_URL=
